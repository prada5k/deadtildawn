[gd_scene format=3]

[ext_resource type="Script" path="res://screens/scout.gd" id="1"]
[ext_resource type="Script" path="res://track_map.gd" id="2"]
[ext_resource type="Script" path="res://widgets/severity_key.gd" id="3"]

[node name="Scout" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Frame" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10

[node name="Scroll" type="ScrollContainer" parent="Frame"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Column" type="VBoxContainer" parent="Frame/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="Where" type="Label" parent="Frame/Scroll/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
rotation = -0.012
theme_type_variation = &"TapeLabel"
text = "fri week 1 // open road"

[node name="Sheet" type="PanelContainer" parent="Frame/Scroll/Column"]
layout_mode = 2
rotation = 0.004
theme_type_variation = &"PaperPanel"

[node name="Box" type="VBoxContainer" parent="Frame/Scroll/Column/Sheet"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Frame/Scroll/Column/Sheet/Box"]
layout_mode = 2

[node name="Title" type="Label" parent="Frame/Scroll/Column/Sheet/Box/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"InkHeadingLabel"
text = "THE ROAD"

[node name="RoadInfo" type="Label" parent="Frame/Scroll/Column/Sheet/Box/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"InkMutedLabel"
text = "1066 m, 5 corners"

[node name="MapRow" type="HBoxContainer" parent="Frame/Scroll/Column/Sheet/Box"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Map" type="Control" parent="Frame/Scroll/Column/Sheet/Box/MapRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 440)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"InkTrackMap"
script = ExtResource("2")

[node name="Key" type="Control" parent="Frame/Scroll/Column/Sheet/Box/MapRow"]
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"InkTrackMap"
script = ExtResource("3")

[node name="Read" type="VBoxContainer" parent="Frame/Scroll/Column/Sheet/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2

[node name="Build" type="PanelContainer" parent="Frame/Scroll/Column"]
layout_mode = 2
rotation = -0.006
theme_type_variation = &"PaperPanel"

[node name="BuildBox" type="VBoxContainer" parent="Frame/Scroll/Column/Build"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="BuildTitle" type="Label" parent="Frame/Scroll/Column/Build/BuildBox"]
layout_mode = 2
theme_type_variation = &"InkMutedLabel"
text = "THE DX AS IT SITS"

[node name="BuildStats" type="VBoxContainer" parent="Frame/Scroll/Column/Build/BuildBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2

[node name="WorkOnCar" type="Button" parent="Frame/Scroll/Column/Build/BuildBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
focus_mode = 0
rotation = -0.02
theme_type_variation = &"TapeButton"
text = "work on the car  >"

[node name="Note" type="Label" parent="Frame/Scroll/Column"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Lock it in and that's the build for tonight. Then you find out who's running."
autowrap_mode = 3

[node name="Actions" type="HBoxContainer" parent="Frame"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SkipButton" type="Button" parent="Frame/Actions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"SmallTapeButton"
text = "skip  -50 rep"

[node name="LockIn" type="Button" parent="Frame/Actions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
rotation = -0.012
theme_type_variation = &"GaffRedButton"
text = "LOCK IT IN"
