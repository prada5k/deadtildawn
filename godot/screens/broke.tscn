[gd_scene format=3]

[ext_resource type="Script" path="res://screens/broke.gd" id="1"]

[node name="Broke" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"DymoLabel"
text = "YOU FUCKED IT PA"

[node name="Slip" type="PanelContainer" parent="Margin/Column"]
layout_mode = 2
rotation = -0.01
theme_type_variation = &"PaperPanel"

[node name="Text" type="Label" parent="Margin/Column/Slip"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"InkLabel"
text = "$40 left. Tonight's minimum bet is $100."
autowrap_mode = 3

[node name="ScrapTitle" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
rotation = -0.015
theme_type_variation = &"TapeLabel"
text = "scrap parts to get back in"

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Parts" type="VBoxContainer" parent="Margin/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="BackInBusiness" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"GaffButton"
text = "back in business"

[node name="StartOver" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"GaffRedButton"
text = "START OVER"
